NODE_ENV=development
PORT=3000
# Banco atual (MongoDB Atlas) mantido temporariamente durante a migração para o Supabase.
MONGODB_URI=
# Configuração do Supabase para a fase 1 da migração.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# SMTP para enviar códigos de redefinição de senha (porta 465 ou 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# URI opcional de um banco dedicado para os testes de integração; use um banco vazio de testes.
MONGODB_TEST_URI=
