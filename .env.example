NODE_ENV=development
PORT=3000
# Escolha explícita; valores do outro backend não serão usados.
DATABASE_BACKEND=mongo
MONGODB_URI=
SUPABASE_URL=
# Nunca colocar no navegador ou public/; ANON_KEY não é usada pelo servidor.
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
# Deixe TODAS vazias para desabilitar recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Somente IPs/CIDRs do proxy real, se houver. Vazio em acesso direto.
TRUST_PROXY=
# Banco dedicado e descartável, diferente de MONGODB_URI.
MONGODB_TEST_URI=
